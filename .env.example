PORT=8080
DB_URL=jdbc:mysql://host.docker.internal:3306/personal_blog?useSSL=false&serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=blog_app
DB_PASSWORD=replace-with-database-password
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_TTL_SECONDS=86400
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# For TiDB Cloud: jdbc:mysql://<host>:4000/personal_blog?sslMode=VERIFY_IDENTITY&serverTimezone=UTC&characterEncoding=UTF-8
# Same-origin production deployment needs no CORS origins.
DB_POOL_SIZE=5
MAX_REQUEST_BYTES=1048576
LOGIN_PER_MINUTE=20
ACCOUNT_LOGIN_PER_MINUTE=5
REGISTRATION_PER_HOUR=5
WRITES_PER_MINUTE=60
READS_PER_MINUTE=240
LIMITER_MAX_KEYS=20000
REGISTRATION_ENABLED=true
SENSITIVE_PER_MINUTE=5
EMAIL_PER_HOUR=3
MAX_STORAGE_BYTES=20971520
MAX_ARTICLES=1000
MAX_COMMENTS=10000
MAX_CATEGORIES=200
# Personal use for now. Enable the publication gate when verified email is available.
REQUIRE_VERIFIED_EMAIL_FOR_PUBLICATION=false
# Email verification and password recovery are deferred. Never use unverified emails for recovery.
MAIL_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.invalid
MAIL_PUBLIC_BASE_URL=http://localhost:8080
MAIL_STARTTLS_REQUIRED=true
MAIL_SSL_ENABLED=false
